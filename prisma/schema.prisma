// Prisma schema - mirrors the Supabase tables used by Grupo Lamoia audit system.
// Used only when Supabase env vars are NOT set (sandbox/local preview).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./db/custom.db"
}

model Users {
  id_user    Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  Login      String?  @unique
  Senha      String?
  Tipo       String?  // 'Admin Senior' | 'Admin Junior' | 'Comercial' | 'Qualidade' | 'User' ...
  Nome       String?
  Status     String?  // 'a' = ativo, 'i' = inativo
  ag_agenda_ag_agenda_id_gerenteToUsers   ag_agenda[] @relation("ag_agenda_id_gerenteToUsers")
  ag_agenda_ag_agenda_id_vendedorToUsers  ag_agenda[] @relation("ag_agenda_id_vendedorToUsers")
}

model Clientes {
  id        Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  Codigo    Int      @unique
  Razao     String?
  CNPJ_CPF  BigInt?
  Endereco  String?
  Bairro    String?
  Cidade    String?
  UF        String?
  ag_agenda_diaria ag_agenda_diaria[]
}

model ag_agenda {
  id_agenda     Int      @id @default(autoincrement())
  data_criacao  DateTime @default(now())
  id_gerente    Int?
  id_vendedor   Int?
  status_atual  String?  // 'Pendente' | 'Finalizado' | 'Cancelado'
  data_agenda   DateTime?
  mes_referencia String? // 'MM-YYYY'
  placa         String?
  // ⚠️ Changed from String? to DateTime? to mirror Supabase schema
  // (timestamp without time zone). The app converts between "HH:MM" and Date.
  hora_inicial  DateTime?
  hora_fim      DateTime?
  total_hora    String?   // remains text — format "HH:MM"
  eficiencia    Float?
  id_auditor    Int?
  data_aud      DateTime?
  almoco        String?  // 'S' | 'N'
  obs_geral     String?
  Users_UsersToag_agenda_id_gerente   Users?   @relation("ag_agenda_id_gerenteToUsers", fields: [id_gerente], references: [id_user], onDelete: Cascade, onUpdate: Cascade)
  Users_UsersToag_agenda_id_vendedor  Users?   @relation("ag_agenda_id_vendedorToUsers", fields: [id_vendedor], references: [id_user], onDelete: Cascade, onUpdate: Cascade)
  ag_agenda_diaria ag_agenda_diaria[]
}

model ag_agenda_diaria {
  id_ad              Int      @id @default(autoincrement())
  id_a               Int?
  id_clientes        Int?
  status_atendimento String?  // 'Pendente' | 'Pendente Auditoria' | 'Em Atendimento' | 'Realizado' | 'Cancelado'
  // ⚠️ Renamed from data_hora_atendimento to data_hora_atendimento_inicio (timestamp without time zone)
  // + added data_hora_atendimento_fim (timestamp without time zone)
  data_hora_atendimento_inicio DateTime?
  data_hora_atendimento_fim    DateTime?
  observacao         String?
  latitude           String?
  longitude          String?
  ag_agenda          ag_agenda? @relation(fields: [id_a], references: [id_agenda], onDelete: Cascade, onUpdate: Cascade)
  Clientes           Clientes?  @relation(fields: [id_clientes], references: [Codigo], onDelete: Cascade, onUpdate: Cascade)
  fotos_vis          fotos_vis[]
}

model fotos_vis {
  id_foto    Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  id_vis     Int?
  Nome_Foto  String?  @unique
  Tipo       String?  // 'Fachada' | 'Antes' | 'Depois'
  Loc_Foto   String?  // URL or path to the photo
  ag_agenda_diaria ag_agenda_diaria? @relation(fields: [id_vis], references: [id_ad], onDelete: Cascade, onUpdate: Cascade)
}

model log_acesso {
  id_log     Int      @id @default(autoincrement())
  id_user    Int?
  login      String?
  ip         String?
  user_agent String?
  data_hora  DateTime @default(now())
}
